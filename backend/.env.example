# Backend (Express) — variáveis de ambiente necessárias.
# Copie este arquivo para ".env" na mesma pasta e preencha com os valores reais.
# O .env nunca deve ser commitado/compartilhado — ele guarda senhas e tokens.
# (o install.sh já gera este arquivo sozinho — isto aqui é só referência)

# Porta em que o servidor Express roda
PORT=5000

# PostgreSQL (usuários, configurações de turnos/sensores, layout do dashboard, histórico de alarmes)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=forno_db
POSTGRES_PORT=5432

# InfluxDB 3 e API do Wtecc Historian — projeto SEPARADO (github.com/ronthel/wtecc-historian),
# pode estar nesta mesma máquina ou em outro servidor. Aponte pro IP/porta reais dele.
INFLUX_URL=http://localhost:8181
INFLUX_TOKEN=
INFLUX_BUCKET=forno
HISTORIAN_API_URL=http://localhost:8000
HISTORIAN_VIEWER_PASSWORD=

# Autenticação — chave secreta usada para assinar os tokens JWT de login
JWT_SECRET=
