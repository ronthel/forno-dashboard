# Serviço PLC -> InfluxDB (plc-service) — variáveis de ambiente necessárias.
# Copie este arquivo para ".env" na mesma pasta e preencha com os valores reais.
# O .env nunca deve ser commitado/compartilhado — ele guarda o token do InfluxDB.
#
# Mesmo InfluxDB usado pelo backend do dashboard (backend/.env) — os valores
# aqui devem ser os mesmos lá.

INFLUX_URL=http://127.0.0.1:8181
INFLUX_TOKEN=
INFLUX_BUCKET=forno
